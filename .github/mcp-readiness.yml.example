name: MCP Release Readiness

on:
  pull_request:
  push:
    branches: [main]

permissions:
  contents: read

jobs:
  readiness:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.11'
      - name: Install analyzer
        run: python -m pip install -e ./mcp-readiness pytest
      - name: Run tests
        run: python -m pytest -q ./mcp-readiness/tests
      - name: Run MCP release check
        run: mcp-readiness --demo --output mcp-readiness-report --fail-under 55
      - name: Upload score, badge and guided fixes
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: mcp-readiness-report
          path: mcp-readiness-report/
